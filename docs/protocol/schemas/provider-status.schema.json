{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tabbeam.local/protocol/v1/provider-status.schema.json",
  "title": "TabBeam Protocol v1 Provider Status Payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider_id", "status"],
  "properties": {
    "provider_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["availability", "authentication", "capabilities"],
      "properties": {
        "availability": {
          "type": "string",
          "enum": ["available", "unavailable", "not_found", "unknown"]
        },
        "authentication": {
          "type": "string",
          "enum": ["authenticated", "unauthenticated", "unknown"]
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "streaming",
            "continuation",
            "web_search",
            "page_context",
            "attachments",
            "model_selection",
            "cancellation"
          ],
          "properties": {
            "streaming": {"$ref": "#/$defs/capability"},
            "continuation": {"$ref": "#/$defs/capability"},
            "web_search": {"$ref": "#/$defs/capability"},
            "page_context": {"$ref": "#/$defs/capability"},
            "attachments": {"$ref": "#/$defs/capability"},
            "model_selection": {"$ref": "#/$defs/capability"},
            "cancellation": {"$ref": "#/$defs/capability"}
          }
        },
        "models": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$"
              },
              "label": {"type": "string", "minLength": 1, "maxLength": 64}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "capability": {
      "oneOf": [
        {"type": "boolean"},
        {"const": "unknown"}
      ]
    }
  }
}
