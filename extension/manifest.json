{
  "manifest_version": 3,
  "name": "TabBeam",
  "description": "A lightweight, provider-independent browser AI command layer.",
  "version": "0.1.0",
  "minimum_chrome_version": "123",
  "action": {
    "default_title": "TabBeam",
    "default_popup": "src/popup/index.html"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "nativeMessaging",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/content/content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Command+Shift+P"
      }
    }
  }
}
